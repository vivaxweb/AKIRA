# EduSync Academic Hub — Backend Environment Configuration
# Copy this file to backend/.env

# Django Settings
DEBUG=True
SECRET_KEY=django-insecure-edusync-academic-hub-demo-secret-key-ay-2026-27
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (Dual-mode: SQLite default, PostgreSQL optional)
# SQLite (default for zero-setup local evaluation):
DATABASE_URL=sqlite:///db.sqlite3
# PostgreSQL (production/container mode):
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/edusync_academic_hub

# CORS & Frontend Origin (in DEBUG mode, localhost origins on any port are accepted automatically)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# Groq API Key for AI Knowledge Assistant
# If left empty, assistant operates in offline deterministic fallback mode
GROQ_API_KEY=
