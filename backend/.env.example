# Department Digital Hub — Backend Environment Configuration
# Copy this file to backend/.env

# Django Settings
DEBUG=True
SECRET_KEY=django-insecure-department-digital-hub-demo-secret-key-ay-2026-27
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (Dual-mode: SQLite default, PostgreSQL optional)
# SQLite (default for zero-setup local evaluation):
DATABASE_URL=sqlite:///db.sqlite3
# PostgreSQL (production/container mode):
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/department_digital_hub

# CORS & Frontend Origin
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Groq API Key for AI Knowledge Assistant (Phase 10)
# If left empty, assistant operates in offline deterministic fallback mode
GROQ_API_KEY=
