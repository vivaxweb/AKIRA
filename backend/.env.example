# Department Digital Hub — Backend Environment Example
# Copy this file to .env and fill in real values.
# Never commit .env to version control.

# Django core
DEBUG=True
SECRET_KEY=change-me-use-a-long-random-string-in-production
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (leave unset or use sqlite:/// for local SQLite default)
# DATABASE_URL=postgresql://user:password@localhost:5432/ddh

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Email backend (console is fine for development)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=

# Similarity engine
# SIMILARITY_BACKEND=tfidf  (default; set to 'embeddings' if sentence-transformers is installed)
# SIMILARITY_THRESHOLD=0.4   (uncalibrated default — run scripts/similarity_demo.py to calibrate)

# AI Assistant (optional — leave blank to run without AI)
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# EMBEDDING_BACKEND=local   (or hf_api)

# ChromaDB path (for embeddings backend)
# CHROMA_PATH=.chroma

# File uploads
# MAX_UPLOAD_SIZE_MB=20

# Analytics thresholds (all are configurable defaults, NOT official rules)
# MARK_DROP_THRESHOLD=15.0
