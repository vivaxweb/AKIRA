      - id
      - student
      - student_name
      - student_roll
    AttendanceRecordStatusEnum:
      enum:
      - PRESENT
      - ABSENT
      - LEAVE
      type: string
      description: |-
        * `PRESENT` - Present
        * `ABSENT` - Absent
        * `LEAVE` - Leave
    AttendanceSession:
