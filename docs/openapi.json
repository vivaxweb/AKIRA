components:
  schemas:
    AccreditationBodyEnum:
      enum:
      - NBA
      - NAAC
      type: string
      description: |-
        * `NBA` - NBA (National Board of Accreditation)
        * `NAAC` - NAAC (National Assessment and Accreditation Council)
    AccreditationCriteriaDetail:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        department:
          type: integer
          readOnly: true
        code:
          type: string
          description: e.g. C1, C2, C3...
          maxLength: 20
        title:
          type: string
          maxLength: 255
        description:
          type: string
        accreditation_body:
          allOf:
          - $ref: '#/components/schemas/AccreditationBodyEnum'
          default: NBA
        max_marks:
          type: integer
          maximum: 9223372036854775807
          minimum: 0
          format: int64
        obtained_marks:
          type: string
          format: decimal
          pattern: ^-?\d{0,3}(?:\.\d{0,2})?$
        status:
          $ref: '#/components/schemas/StatusD7cEnum'
        evidences:
          type: array
          items:
            $ref: '#/components/schemas/EvidenceLink'
          readOnly: true
        evidences_count:
          type: integer
          readOnly: true
        created_at:
          type: string
          format: date-time
          readOnly: true
        updated_at:
          type: string
          format: date-time
          readOnly: true
      required:
      - code
      - created_at
      - department
      - evidences
      - evidences_count
      - id
      - title
      - updated_at
    AccreditationCriteriaList:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        department:
          type: integer
          readOnly: true
        code:
          type: string
          description: e.g. C1, C2, C3...
          maxLength: 20
        title:
          type: string
          maxLength: 255
        description:
          type: string
        accreditation_body:
          allOf:
          - $ref: '#/components/schemas/AccreditationBodyEnum'
          default: NBA
        max_marks:
          type: integer
          maximum: 9223372036854775807
          minimum: 0
          format: int64
        obtained_marks:
          type: string
          format: decimal
          pattern: ^-?\d{0,3}(?:\.\d{0,2})?$
        status:
          $ref: '#/components/schemas/StatusD7cEnum'
        evidences_count:
          type: integer
          readOnly: true
        created_at:
          type: string
          format: date-time
          readOnly: true
        updated_at:
          type: string
          format: date-time
          readOnly: true
      required:
      - code
      - created_at
      - department
      - evidences_count
      - id
      - title
      - updated_at
    Assessment:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        subject:
          type: integer
        subject_code:
          type: string
          readOnly: true
        subject_name:
          type: string
          readOnly: true
        name:
          type: string
          maxLength: 100
        kind:
          $ref: '#/components/schemas/AssessmentKindEnum'
        max_marks:
          type: string
          format: decimal
          pattern: ^-?\d{0,3}(?:\.\d{0,2})?$
        weightage:
          type: string
          format: decimal
          pattern: ^-?\d{0,3}(?:\.\d{0,2})?$
          nullable: true
        date:
          type: string
          format: date
        is_published:
          type: boolean
        linked_cos:
          type: string
          readOnly: true
        created_at:
          type: string
          format: date-time
          readOnly: true
      required:
      - created_at
      - date
      - id
      - linked_cos
      - max_marks
      - name
      - subject
      - subject_code
      - subject_name
    AssessmentKindEnum:
      enum:
      - CIE
      - ASSIGNMENT
      - PRACTICAL
      - OTHER
      type: string
      description: |-
        * `CIE` - Continuous Internal Evaluation
        * `ASSIGNMENT` - Assignment
        * `PRACTICAL` - Practical Exam
        * `OTHER` - Other
    AttainmentConfig:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        department:
          type: integer
        target_pct:
          type: string
          format: decimal
          pattern: ^-?\d{0,3}(?:\.\d{0,2})?$
          description: Target score % for a student to achieve CO
        level3_pct:
          type: string
          format: decimal
          pattern: ^-?\d{0,3}(?:\.\d{0,2})?$
          description: '% of students reaching target for Level 3'
        level2_pct:
          type: string
          format: decimal
          pattern: ^-?\d{0,3}(?:\.\d{0,2})?$
          description: '% of students reaching target for Level 2'
        level1_pct:
          type: string
          format: decimal
          pattern: ^-?\d{0,3}(?:\.\d{0,2})?$
          description: '% of students reaching target for Level 1'
        pass_mark_pct:
          type: string
          format: decimal
          pattern: ^-?\d{0,3}(?:\.\d{0,2})?$
          description: Minimum pass mark %
        min_attendance_pct:
          type: string
          format: decimal
          pattern: ^-?\d{0,3}(?:\.\d{0,2})?$
          description: Minimum attendance cutoff %
      required:
      - department
      - id
