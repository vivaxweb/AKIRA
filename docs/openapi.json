          description: ''
  /api/v1/auth/me/:
    get:
      operationId: auth_me_retrieve
      description: |-
        GET /api/v1/auth/me/
        Returns currently authenticated user profile.
        PATCH /api/v1/auth/me/
        Allows updating own first_name, last_name, phone.
      tags:
